# ignore files (likely datasets or graphics) if too large (> 100 MB)
# specify pathway to dataset data/project_dataset.csv
# if all datasets are too large then use data/*.csv (only ignores CSVs)
# if you have other file types then use appropriate extension data/*.rds
# or
# to automatically find and add files over 100MB to the .gitignore you can type 
# the following code in the Terminal:
# find . -size +100M | sed 's|^\./||g' | cat >> .gitignore; awk '!NF || !seen[$0]++' .gitignore

